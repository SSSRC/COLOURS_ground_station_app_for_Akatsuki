{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext", /* ここを "commonjs" から変更 */
    //"module": "commonjs",
    "skipLibCheck": true,
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*"]
    }
  },
  "include": [
    "src/**/*"
  ]
}